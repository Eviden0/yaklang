+		scanOpt := make([]ssaconfig.Option, 0)
+		if config != nil && config.Config != nil {
+			if raw, jsonErr := config.Config.ToJSONRaw(); jsonErr == nil && len(raw) > 0 {
+				scanOpt = append(scanOpt, ssaconfig.WithJsonRawConfig(raw))
